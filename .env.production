# Dokploy Configuration
DOKPLOY_REGISTRY=localhost:5000
DOKPLOY_TAG=latest
DOKPLOY_URL=https://dokploy.solewatch.com
DOKPLOY_TOKEN=your-dokploy-token
DOKPLOY_APP_ID=your-application-id

# FTP Server Configuration
FTP_PORT=21
FTP_USER=finale
FTP_PASSWORD=inventory123
FTP_PASSIVE_PORT_START=10000
FTP_PASSIVE_PORT_END=10100
PASV_URL=your-server-ip-or-domain

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=finale_inventory
